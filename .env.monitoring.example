# Fill values before starting Compose. Use a URL-safe database password.
MONITORING_DB_PASSWORD=
MONITORING_ADMIN_TOKEN=
MONITORING_S3_ACCESS_KEY=
MONITORING_S3_SECRET_KEY=
MONITORING_S3_BUCKET=burbot-monitoring
MONITORING_S3_PUBLIC_URL=http://127.0.0.1:9000
BURBOT_MONITORING_SNAPSHOT_MODE=minimal
BURBOT_MONITORING_FULL_SNAPSHOT_MAX_MB=256
BURBOT_MONITORING_FULL_RESOURCE_MAX_MB=32
